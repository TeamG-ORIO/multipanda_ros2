<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orio_task_supervisor</name>
  <version>0.1.0</version>
  <description>
    Task supervisor: finite state machine that orchestrates the full
    pick-label-place sequence for the dual-arm system.
    Single point of control; the GUI and all external triggers go through
    this node exclusively.
  </description>
  <maintainer email="dev@todo.todo">developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>orio_dual_arm_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
