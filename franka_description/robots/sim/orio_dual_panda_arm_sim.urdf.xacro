<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_panda">
  <xacro:arg name="arm_id_1" default="mj_left"/> <!-- Name of this panda -->
  <xacro:arg name="arm_id_2" default="mj_right"/> <!-- Name of this panda -->
  <xacro:arg name="hand_1" default="false"/> <!-- Should a franka_gripper be mounted at the flange?" -->
  <xacro:arg name="hand_2" default="false"/> <!-- Should a franka_gripper be mounted at the flange?" -->
  <xacro:arg name="initial_positions_1" default="0.0 ${-pi/4} 0.0 ${-3*pi/4} 0.0 ${pi/2} ${pi/4}"/> <!-- initial joint positions of the robot-->
  <xacro:arg name="initial_positions_2" default="0.0 ${-pi/4} 0.0 ${-3*pi/4} 0.0 ${pi/2} ${pi/4}"/> <!-- initial joint positions of the robot-->

  <link name="base_link">
    <visual>
      <geometry>
         <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
         <box size="0.1 0.1 0.1"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>

  <!-- Arm positions match orio_mj_dual.xml:
       mj_left_link0:  pos="-0.546 0.343 0.9" quat="-0.7071 0 0 0.7071" -> rpy="-pi/2 0 0"
       mj_right_link0: pos="0.686  0     0.9" quat="0 0 0 1"        -> rpy="0 0 pi" -->
  <xacro:include filename="$(find franka_description)/robots/common/panda_arm.xacro"/>
  <xacro:panda_arm arm_id="$(arg arm_id_1)" connected_to="base_link" rpy="0 0 ${-pi/2}"    xyz="-0.546 0.343 0.9"    safety_distance="0.03"/>
  <xacro:panda_arm arm_id="$(arg arm_id_2)" connected_to="base_link" rpy="0 0 ${pi}"       xyz="0.686 0 0.9" safety_distance="0.03"/>

  <xacro:if value="$(arg hand_1)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand ns="$(arg arm_id_1)" rpy="0 0 ${-pi/4}" connected_to="$(arg arm_id_1)_link8" safety_distance="0.03"/>
  </xacro:if>
  <xacro:if value="$(arg hand_2)">
    <xacro:include filename="$(find franka_description)/robots/common/hand.xacro"/>
    <xacro:hand ns="$(arg arm_id_2)" rpy="0 0 ${-pi/4}" connected_to="$(arg arm_id_2)_link8" safety_distance="0.03"/>
  </xacro:if>
  <xacro:include filename="$(find franka_description)/robots/sim/orio_environment.xacro"/>
  <xacro:orio_environment parent="base_link"/>

  <xacro:include filename="$(find franka_description)/robots/sim/dual_panda_arm_sim.ros2_control.xacro"/>
  <xacro:dual_panda_mjros_ros2_control
      ns_1="$(arg arm_id_1)"
      ns_2="$(arg arm_id_2)"
      hand_1="$(arg hand_1)"
      hand_2="$(arg hand_2)"
      initial_positions_1="$(arg initial_positions_1)"
      initial_positions_2="$(arg initial_positions_2)"/>
</robot>
