<mujoco model="panda dual scene">
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_wood" rgba="0.5 0.4 0.3 1"/>
    <material name="frame_metal" rgba="0.2 0.2 0.2 1"/>
  </asset>

  <include file="orio_mj_dual.xml"/>
  
  <statistic center="-0.2 0 0.9" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>
    
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table_1" pos="0.343 0 0.45">
      <geom name="table_top_1" type="box" size="0.343 0.546 0.45" material="table_wood"/>
      
      <body name="frame_1" pos="-0.323 0 0.45">
          <geom name="post_1_l" type="box" size="0.02 0.02 0.50" pos="0 -0.526 0.50" material="frame_metal"/>
          <geom name="post_1_r" type="box" size="0.02 0.02 0.50" pos="0 0.526 0.50" material="frame_metal"/>
          <geom name="crossbar_1" type="box" size="0.02 0.546 0.02" pos="0 0 1.00" material="frame_metal"/>
      </body>
    </body>

    <body name="table_2" pos="-0.546 0 0.45">
      <geom name="table_top_2" type="box" size="0.546 0.343 0.45" material="table_wood"/>
      
      <body name="frame_2" pos="-0.526 0 0.45">
          <geom name="post_2_l" type="box" size="0.02 0.02 0.50" pos="0 -0.323 0.50" material="frame_metal"/>
          <geom name="post_2_r" type="box" size="0.02 0.02 0.50" pos="0 0.323 0.50" material="frame_metal"/>
          <geom name="crossbar_2" type="box" size="0.02 0.343 0.02" pos="0 0 1.00" material="frame_metal"/>
      </body>
    </body>
  </worldbody>
</mujoco>